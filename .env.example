# 🏦 BankRange Topology Configuration
BR_NUM_BRANCHES=5
BR_WORKSTATIONS_PER_BRANCH=10
BR_EMPLOYEES_PER_BRANCH=15

# 💻 OS Distribution (Must sum to exactly 100)
BR_WINDOWS_PCT=80
BR_LINUX_PCT=15
BR_MACOS_PCT=5

# ⚡ Performance
BR_BASE_EPS=1.0

# 🔌 Infrastructure
BR_KAFKA_BROKERS=localhost:9092
BR_LOKI_URL=http://localhost:3100

# 🔐 Security
# API key required for POST /control — leave empty to disable auth (dev only)
BR_API_KEY=change-me-in-production
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:8080
